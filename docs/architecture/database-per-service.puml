@startuml Kyro_Database_Per_Service
title Kyro - Database-per-service Architecture
left to right direction
skinparam shadowing false

rectangle "Auth Service" as auth
rectangle "Catalog Service" as catalog
rectangle "Cart Service" as cart
rectangle "Order Service" as order
rectangle "Payment Service" as payment
queue "RabbitMQ" as rabbitmq

database "PostgreSQL 16 instance" as postgres {
  database "kyro_auth" as auth_db
  database "kyro_catalog" as catalog_db
  database "kyro_order" as order_db
  database "kyro_payment" as payment_db
}
database "Redis 7\ncart:{userId}" as redis

auth --> auth_db : owns
catalog --> catalog_db : owns
order --> order_db : owns
payment --> payment_db : owns
cart --> redis : owns

order ..> auth : Feign
order ..> catalog : Feign
order ..> cart : Feign
payment --> rabbitmq : payment.status.updated
rabbitmq --> order : consume event

note bottom of postgres
  Separate databases on one PostgreSQL instance.
  No SQL join or foreign key crosses a service boundary.
end note
@enduml
