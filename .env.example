# Docker Compose Configuration
COMPOSE_PROJECT_NAME=kyro-backend

# Server Configuration
PORT=8080
API_PREFIX=/api/v1

# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres_password
DATABASE_DB=postgres

# JPA / Hibernate
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true
JPA_GLOBALLY_QUOTED_IDENTIFIERS=false

# Security & OAuth2
OAUTH2_GOOGLE_CLIENT_ID=mock-google-client-id
OAUTH2_GOOGLE_CLIENT_SECRET=mock-google-client-secret
OAUTH2_GITHUB_CLIENT_ID=mock-github-client-id
OAUTH2_GITHUB_CLIENT_SECRET=mock-github-client-secret

# Mail Settings
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=mock_email@gmail.com
MAIL_PASSWORD=mock_password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

# Auth Token
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=86400000
INTERNAL_API_TOKEN=replace-with-a-long-random-service-token

# App Settings
USE_SECURE_COOKIE=false
OTP_EXPIRATION_MINUTES=10
OTP_RESEND_COOLDOWN_MINUTES=1
COMPANY_LOGO_URL=https://kyro.com/logo.png
OAUTH2_REDIRECT_URI=http://localhost:5173/oauth2/redirect
OAUTH2_FAILURE_REDIRECT_URI=http://localhost:5173/login?error=true

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Cloudinary
CLOUDINARY_CLOUD_NAME=mock_cloud
CLOUDINARY_API_KEY=mock_key
CLOUDINARY_API_SECRET=mock_secret
CLOUDINARY_API_SECURE=true

# VNPay
VNPAY_TMN_CODE=mock_code
VNPAY_HASH_SECRET=mock_secret
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/checkout?step=4

# Dedicated CUSTOMER account for k6 (set real values in local .env or CI secrets)
K6_USER_EMAIL=k6-customer@example.com
K6_USER_PASSWORD=replace-me

# Contact Info
CONTACT_PHONE=0123456789
CONTACT_EMAIL=contact@kyro.com
CONTACT_ADDRESS=123 Street, City
CONTACT_BUSINESS_HOURS=9 AM - 6 PM
CONTACT_FACEBOOK=https://facebook.com/kyro
CONTACT_INSTAGRAM=https://instagram.com/kyro
CONTACT_YOUTUBE=https://youtube.com/kyro
